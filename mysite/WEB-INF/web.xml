<?xml version="1.0" encoding="UTF-8"?>
<!--
XML은HTML과 형제지간으로,최소 SGML이라는 마크업 언어에서 파생된 기술임..

HTML - how to show design !!(브라우저에 모습이 어떻게 표현될 것인가?)
XML - how to make data (데이터를 어떻게 표현할 것인가?)

[특징]
1)XML은 대소문자를 가림
2) HTML 과 달리 사용자가 태그를 정의할 수 있으므로, 사용자 정의 태그라 불림
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                      http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
  version="4.0"
  metadata-complete="true">
  
  <servlet>
	<servlet-name>guguServlet</servlet-name>
	<servlet-class>com.hexagon.myapp.test.Gugudan</servlet-class>
	
  </servlet>

  <servlet-mapping>
	<servlet-name>guguServlet</servlet-name>
	<url-pattern>/gugu</url-pattern>
	</servlet-mapping>

</web-app>


