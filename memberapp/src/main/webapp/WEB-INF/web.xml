<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	id="WebApp_ID" version="4.0">
	<display-name>memberapp</display-name>


	<servlet>
		<servlet-name>memberRegist</servlet-name>
		<servlet-class>com.hexagon.memberapp.member.RegistServlet</servlet-class>
	</servlet>


	<servlet-mapping>
		<servlet-name>memberRegist</servlet-name>
		<url-pattern>/member/regist</url-pattern>
	</servlet-mapping>
	

	<servlet>
		<servlet-name>oracleRegist</servlet-name>
		<servlet-class>com.hexagon.memberapp.member.RegistOracle</servlet-class>
	</servlet>


	<servlet-mapping>
		<servlet-name>oracleRegist</servlet-name>
		<url-pattern>/oracle/regist</url-pattern>
	</servlet-mapping>	
</web-app>